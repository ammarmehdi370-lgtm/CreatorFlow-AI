# Required for database-backed routes and Prisma commands.
NODE_ENV=development
DATABASE_URL=postgresql://creatorflow:local@localhost:5432/creatorflow?schema=public
REDIS_URL=redis://localhost:6379

# Application origin and authentication integration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Local media processing. FFMPEG_PATH may be "ffmpeg" when available on PATH.
FFMPEG_PATH=ffmpeg
RENDER_OUTPUT_DIR=./var/renders

# Object storage (needed when remote media storage is implemented).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# AI script and metadata generation providers (optional until enabled).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Speech recognition/caption providers (optional until enabled).
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Voice generation providers (optional until enabled).
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=

# Billing integration (optional until enabled).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=