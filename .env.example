# App
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creatorflow?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creatorflow-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_URL=http://localhost:9000

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Speech-to-text
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Voice providers
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=

# Blob / rendering
FFMPEG_PATH=ffmpeg

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Auth providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics / telemetry
NEXT_PUBLIC_APP_URL=http://localhost:3000
