generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  authProvider  String?
  authSubject   String?
  name          String?
  timezone      String?
  language      String?  @default("en")
  avatarUrl     String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships      Membership[]
  ownedProjects    Project[]
  usageLedger      UsageLedger[]
  notifications    Notification[]
  connectedAccounts ConnectedAccount[]

  @@index([status])
}

model Workspace {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  plan        String   @default("free")
  status      String   @default("active")
  brandName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   Membership[]
  projects      Project[]
  templates     Template[]
  subscriptions Subscription[]
  notifications Notification[]
  audits        AuditLog[]

  @@index([plan, status])
}

model Membership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("editor")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Subscription {
  id                  String   @id @default(uuid())
  workspaceId         String
  provider            String
  providerCustomerId  String?
  providerSubscriptionId String?
  status              String   @default("inactive")
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, provider])
  @@index([status, currentPeriodEnd])
}

model UsageLedger {
  id            String   @id @default(uuid())
  workspaceId    String
  userId        String?
  projectId     String?
  jobId         String?
  type          String
  units         Float    @default(0)
  amountCredits  Int      @default(0)
  status        String   @default("reserved")
  metadata      Json?
  createdAt     DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([jobId])
}

model Project {
  id               String   @id @default(uuid())
  workspaceId      String
  ownerId          String
  title            String
  description      String?
  type             String   @default("youtube")
  format           String   @default("16:9")
  status           String   @default("draft")
  language         String?  @default("en")
  targetDuration   Int?
  latestVersion    Int      @default(1)
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  owner     User      @relation(fields: [ownerId], references: [id])

  settings        ProjectSettings?
  scripts         Script[]
  scenes          Scene[]
  usageLedger     UsageLedger[]
  renderJobs      RenderJob[]
  exports        Export[]
  thumbnails     Thumbnail[]
  seoData        SEOData[]
  mediaAssets    MediaAsset[]
  notifications  Notification[]
  aiJobs         AIJob[]

  @@index([workspaceId, status, updatedAt])
}

model ProjectSettings {
  id          String   @id @default(uuid())
  projectId   String   @unique
  format      String   @default("16:9")
  duration    Int?
  language    String?  @default("en")
  tone        String?
  audience    String?
  brandName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model Script {
  id             String   @id @default(uuid())
  projectId      String
  version        Int      @default(1)
  title          String?
  content        String
  status         String   @default("draft")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  scenes  Scene[]

  @@index([projectId, version])
}

model Scene {
  id              String   @id @default(uuid())
  projectId       String
  scriptId        String?
  position        Int
  title           String?
  narration       String?
  visualBrief     String?
  assetType       String?
  duration        Int?
  status          String   @default("draft")
  transition      String?
  onScreenText    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  script  Script? @relation(fields: [scriptId], references: [id])

  @@index([projectId, position])
}

model MediaAsset {
  id            String   @id @default(uuid())
  workspaceId    String
  projectId     String?
  kind          String   // image, audio, video, document, thumbnail
  storageKey    String
  mimeType      String
  url           String?
  width         Int?
  height        Int?
  duration      Int?
  checksum      String?
  rightsStatus  String   @default("unknown")
  source        String?
  metadata      Json?
  status        String   @default("ready")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])

  @@index([workspaceId, kind, status])
  @@index([checksum])
}

model Voice {
  id            String   @id @default(uuid())
  projectId     String?
  provider      String
  model         String?
  voiceId       String
  language      String?
  accent        String?
  emotion       String?
  pace          Float?
  pitch         Float?
  pronunciation Json?
  duration      Int?
  cost          Float?
  rightsStatus  String   @default("not-checked")
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([projectId, provider])
}

model Caption {
  id          String   @id @default(uuid())
  projectId   String
  audioRef    String?
  version     Int      @default(1)
  format      String   @default("srt")
  content     String
  style       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, version])
}

model Thumbnail {
  id          String   @id @default(uuid())
  projectId   String
  assetId     String?
  prompt      String?
  status      String   @default("draft")
  selected    Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, selected])
}

model SEOData {
  id          String   @id @default(uuid())
  projectId   String
  version     Int      @default(1)
  title       String?
  description String?
  keywords    Json?
  chapters    Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, version])
}

model RenderJob {
  id              String   @id @default(uuid())
  projectId       String
  version         Int      @default(1)
  status          String   @default("queued")
  progress        Int      @default(0)
  provider        String?
  qualityProfile  String?
  outputPath      String?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  exports Export[]

  @@index([projectId, status, createdAt])
}

model Export {
  id          String   @id @default(uuid())
  projectId   String
  renderJobId String?
  format      String
  storageKey  String
  fileName    String
  sizeBytes   BigInt?
  checksum    String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id])
  renderJob  RenderJob? @relation(fields: [renderJobId], references: [id])

  @@index([projectId, createdAt])
}

model Template {
  id          String   @id @default(uuid())
  workspaceId String?
  slug        String
  name        String
  kind        String   @default("system")
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, kind])
}

model AIJob {
  id             String   @id @default(uuid())
  projectId      String?
  workspaceId    String?
  type           String
  provider       String?
  status         String   @default("queued")
  idempotencyKey String?  @unique
  request        Json?
  response       Json?
  errorCode      String?
  errorMessage   String?
  retryable      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])

  @@index([workspaceId, status, createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  projectId   String?
  type        String
  title       String
  body        String
  read        Boolean  @default(false)
  dedupeKey   String?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])

  @@index([userId, read, createdAt])
  @@unique([dedupeKey])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  actorId     String?
  action      String
  resource    String
  details     Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
}

model ConnectedAccount {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  accountId   String?
  scope       String?
  token       String?
  status      String   @default("connected")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}
